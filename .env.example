# Copy to .env (gitignored) and fill in. Never commit a real key.
# Get one at https://superlinked.com/cloud → Keys
SIE_API_KEY=sk-sie-replace-me

# Optional overrides
SIE_BASE_URL=https://api.superlinked.com      # EU: https://eu.api.superlinked.com
CANTHERIA_EMBED_MODEL=Qwen/Qwen3-Embedding-4B
CANTHERIA_CHAT_MODEL=Qwen/Qwen3.8-27B-FP8
CANTHERIA_RERANK_MODEL=Qwen/Qwen3-Reranker-4B
# Model availability is per-deployment — `cantheria status` lists what your
# account has (GET /v1/models, spends nothing). Chat models scale from zero:
# the first call can take a minute while the endpoint warms up.

# Alternative chat backend (swarm commands only — ingest/audit/hunt).
# Any OpenAI-compatible endpoint; SIE_API_KEY is used when these are unset.
# CANTHERIA_CHAT_BASE_URL=https://api.featherless.ai/v1
# CANTHERIA_CHAT_API_KEY=replace-me
# shorthand — key alone implies the featherless base URL above:
# FEATHERLESS_API_KEY=replace-me
# pick a model that exists on the active backend. On Featherless,
# Qwen3-30B-A3B is the sweet spot — MoE, fast cold-start, drafts good SQL.
# The 4B instruct model works but under-drafts probes; the dense 32B is slow.
# CANTHERIA_CHAT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Sandbox posture
# CANTHERIA_SANDBOX_WALL_S=20
# CANTHERIA_SANDBOX_MEM_MB=512

# Parallel AI — deep research API (https://docs.parallel.ai)
# PARALLEL_API_KEY=replace-me
# deny (default): PoCs lose network egress. allow: needed only to prove a
# blind callback finding — a knowing trade, per run, see sandbox.py:_confine.
# CANTHERIA_SANDBOX_NETWORK=deny
