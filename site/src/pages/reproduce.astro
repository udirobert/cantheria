---
import Base from '../layouts/Base.astro';
import CopyText from '../components/CopyText.astro';
import ReplayDiagram from '../components/ReplayDiagram.astro';

const setup: string[] = [
  'git clone https://github.com/udirobert/cantheria.git',
  'cd cantheria',
  'uv sync',
  'curl -LO https://github.com/udirobert/cantheria/releases/download/v1.0.0/cantheria-demo.tar.gz',
  'tar xzf cantheria-demo.tar.gz',
];
const replays: string[] = [
  'uv run cantheria replay demo/audit5/results.json --corpus demo/audit5/records.db',
  'uv run cantheria replay demo/hunt1/results.json --corpus demo/hunt1/records.db',
  'uv run cantheria replay demo/collusion-audit2/results.json --corpus demo/collusion-audit2/records.db',
];
const pilot: string[] = [
  'tar xzf /absolute/path/to/staged/cantheria-demo.tar.gz',
  'uv run cantheria replay demo/audit3/results.json --corpus demo/audit3/records.db',
];
---

<Base title="Reproduce" description="Replay Cantheria's recorded checks from the public demo artifacts.">
  <section class="hero" style="padding-bottom:1rem;">
    <p class="kicker">Reproduction path</p>
    <h1 style="font-size:clamp(2rem,4.5vw,3.4rem);">Reproduce the checks</h1>
    <p class="lede">
      The commands below replay committed, recorded checks against the public demo artifacts.
      They require Python 3.11+ and uv preinstalled; no account, API key, or login is needed.
      Replaying a slice demonstrates reproducibility of the recorded checks — it is not a new
      audit of the full corpus.
    </p>
  </section>

  <ReplayDiagram />

  <div class="rule-label" id="install">
    <span class="no">01</span>
    <h2>Install and fetch artifacts</h2>
    <span class="note">Release asset: cantheria-demo.tar.gz (v1.0.0)</span>
  </div>

  <div class="cmd-list">
    {setup.map((cmd) => (
      <div class="cmd">
        <code>{cmd}</code>
        <CopyText text={cmd} />
      </div>
    ))}
  </div>
  <p style="font-size:0.85rem;margin-top:0.9rem;">
    <a href="https://github.com/udirobert/cantheria/releases/download/v1.0.0/cantheria-demo.tar.gz">
      Download cantheria-demo.tar.gz directly →
    </a>
  </p>

  <div class="rule-label" id="replay">
    <span class="no">02</span>
    <h2>Replay recorded checks</h2>
    <span class="note">Keyless replay of committed checks</span>
  </div>

  <div class="cmd-list">
    {replays.map((cmd) => (
      <div class="cmd">
        <code>{cmd}</code>
        <CopyText text={cmd} />
      </div>
    ))}
  </div>

  <ul class="limit-list" style="margin-top:1.6rem;">
    <li>Replay verifies the recorded checks as committed, not semantic correctness of every source claim.</li>
    <li>Sliced replay is not exhaustive auditing of the corpus.</li>
    <li>Exact flags are defined by the released CLI; consult the repository README and DEMO notes for the authoritative version.</li>
  </ul>

  <details class="desk-group" style="margin-top:1.6rem;">
    <summary><strong>Pilot audit package — staged, not published</strong></summary>
    <div style="padding:0.8rem 0 0.4rem;font-size:0.95rem;">
      <p>
        A four-run package adds the pilot <code>audit3</code> run (24/24). It is staged
        locally at <code>presentation/inputs/cantheria-demo.tar.gz</code> and targeted
        at a future release (e.g. v1.0.1) that has not been published — there is no
        download link for it yet. The file is local and is not included in a fresh
        repository clone.
      </p>
      <p>
        To inspect it, run from a separate working directory with the staged file
        copied there to avoid mixing extracts — replace the placeholder path in the
        first command:
      </p>
      <div class="cmd-list">
        {pilot.map((cmd) => (
          <div class="cmd">
            <code>{cmd}</code>
            <CopyText text={cmd} />
          </div>
        ))}
      </div>
    </div>
  </details>

  <div class="rule-label">
    <span class="no">03</span>
    <h2>Artifacts and reports</h2>
    <span class="note">Preserved public paths — unchanged by this site</span>
  </div>

  <ul class="limit-list">
    <li><a href="https://udirobert.github.io/cantheria/audit5/">Audit 5 report</a> — existing public report</li>
    <li><a href="https://udirobert.github.io/cantheria/hunt1/">Hunt 1 report</a> — existing public report</li>
    <li><a href="https://udirobert.github.io/cantheria/collusion/">Collusion report</a> — existing public report</li>
    <li><a href="https://github.com/udirobert/cantheria">Repository</a> — source, releases, and run artifacts</li>
  </ul>
</Base>
