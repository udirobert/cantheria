---
import MotionToggle from './MotionToggle.astro';

const base = import.meta.env.BASE_URL;
---

<figure class="artifact replaymap" data-motion data-motion-once="true">
  <figcaption class="artifact-cap">
    <span class="cap-main">How replay works — explanatory diagram, not a running verification.</span>
    <button class="text-btn js-only" type="button" data-motion-replay>Replay diagram motion</button>
    <MotionToggle />
  </figcaption>
  <div class="rd-stage">
    <div class="rd-panel">
      <p class="rd-title">1 · Committed probes</p>
      <svg viewBox="0 0 120 84" aria-hidden="true">
        <rect x="14" y="10" width="80" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.4" />
        <rect x="20" y="16" width="80" height="60" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.4" />
        <path d="M28 28 H90 M28 38 H82 M28 48 H92 M28 58 H70" stroke="var(--ink)" stroke-width="1.1" opacity="0.7" />
      </svg>
      <p class="rd-meta">the same tests, shipped in the run artifact</p>
    </div>
    <svg class="rd-arrow" viewBox="0 0 60 84" aria-hidden="true">
      <path class="rd-draw" pathLength="1" d="M4 42 Q30 42 52 42" stroke="var(--canary-deep)" stroke-width="2" fill="none" />
      <path d="M46 36 L54 42 L46 48" stroke="var(--canary-deep)" stroke-width="2" fill="none" />
    </svg>
    <div class="rd-panel">
      <p class="rd-title">2 · Sliced record</p>
      <svg viewBox="0 0 120 84" aria-hidden="true">
        <rect x="18" y="14" width="84" height="14" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.3" />
        <rect x="18" y="33" width="84" height="14" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.3" />
        <rect x="18" y="52" width="84" height="14" fill="var(--ivory-deep)" stroke="var(--canary-deep)" stroke-width="1.6" />
        <path d="M24 21 H94 M24 40 H94 M24 59 H94" stroke="var(--ink)" stroke-width="1" opacity="0.6" />
      </svg>
      <p class="rd-meta">the shipped records the probes ran against</p>
    </div>
    <svg class="rd-arrow" viewBox="0 0 60 84" aria-hidden="true">
      <path class="rd-draw" pathLength="1" d="M4 42 Q30 42 52 42" stroke="var(--canary-deep)" stroke-width="2" fill="none" />
      <path d="M46 36 L54 42 L46 48" stroke="var(--canary-deep)" stroke-width="2" fill="none" />
    </svg>
    <div class="rd-panel">
      <p class="rd-title">3 · Re-run &amp; compare</p>
      <svg viewBox="0 0 120 84" aria-hidden="true">
        <circle cx="60" cy="44" r="26" fill="none" stroke="var(--ink)" stroke-width="1.5" />
        <path class="rd-draw" pathLength="1" d="M60 18 A26 26 0 0 1 84 36" stroke="var(--canary-deep)" stroke-width="2.4" fill="none" />
        <path d="M84 30 L84 40 L92 33" stroke="var(--canary-deep)" stroke-width="2" fill="none" />
        <path d="M46 44 h10 M60 30 v14 l9 8" stroke="var(--ink)" stroke-width="1.4" fill="none" />
        <path d="M40 62 h40" stroke="var(--teal)" stroke-width="2.2" />
      </svg>
      <p class="rd-meta">compare recorded outcomes — no new claims</p>
    </div>
  </div>
  <p class="rd-links">
    <a href={`${base}reproduce/#install`}>↓ install and fetch the artifacts</a>
    <a href={`${base}reproduce/#replay`}>↓ replay commands</a>
  </p>
</figure>
