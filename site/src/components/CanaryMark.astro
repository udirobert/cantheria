---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: cls = '' } = Astro.props;
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role="img"
  aria-label="Cantheria canary mark"
>
  <path d="M8 30 Q18 14 40 12" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
  <path d="M18 30 Q27 22 40 21" stroke="var(--canary)" stroke-width="2.4" stroke-linecap="round" />
  <path d="M12 36 Q22 32 33 33" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <path d="M40 12 L44 10 M40 12 L43 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <circle cx="37.5" cy="14.5" r="1.6" fill="currentColor" />
</svg>
